{
  "name": "chickentalk",
  "version": "1.0.1",
  "description": "ChickenTalk desktop chat",
  "main": "main.js",
  "author": "ChickenTalk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win portable --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.chickentalk.desktop",
    "productName": "ChickenTalk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ChickenTalk-Portable-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ChickenTalk-Portable-${version}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network;Chat"
    }
  }
}
